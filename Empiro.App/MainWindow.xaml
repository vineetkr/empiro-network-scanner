<Window x:Class="Empiro.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Empiro.App" Title="Empiro — Network &amp; CCTV Discovery Platform" Width="1440" Height="960" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Icon="Assets/Empiro.ico">
 <Grid Background="{DynamicResource BackgroundBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="13,24,13,15">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,23"><Border Background="White" CornerRadius="5" Padding="4,7"><Image Source="Assets/Empiro-logo.jpeg" Stretch="Uniform" Height="32" AutomationProperties.Name="Empiro logo: cat symbol followed by Empiro"/></Border><TextBlock Text="NETWORK SCANNER" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="9,14,5,0"><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,13"/><TextBlock Text="●  Local workspace" Foreground="{DynamicResource GreenBrush}" FontSize="11"/><TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Muted}" FontSize="10" Margin="0,7,0,7"/><TextBlock Text="Empiro 0.2.0 · Release candidate" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    <ListBox ItemsSource="{Binding NavigationGroups}" SelectedItem="{Binding SelectedNavigation}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Width="27" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text=" / " Foreground="{DynamicResource MutedBrush}" Margin="10,0"/><TextBlock Text="{Binding Page}" FontSize="12"/></StackPanel><Grid Grid.Column="1" Height="34" Margin="0,0,16,0"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search IP, name, vendor, service, or tag" AutomationProperties.Name="Search devices"/><TextBlock Text="Search devices, IPs, services…" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="2" Content="{Binding DemoButtonLabel}" Command="{Binding DemoCommand}" Padding="12,7" VerticalAlignment="Center"/></Grid>
   </Border>
   <Grid Grid.Row="1" Margin="28,24,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="{Binding Page}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource InputBrush}" CornerRadius="5" Padding="10,6"><TextBlock Text="{Binding ModeLabel}" FontSize="9" Foreground="{DynamicResource AmberBrush}"/></Border></Grid>
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16,11" Margin="0,0,0,16" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Padding="10,4"/><TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"/></DockPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,9,0,0"/></StackPanel></Border>
    <Grid Grid.Row="2">
     <!-- Dashboard -->
     <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}">
      <StackPanel>
       <Border Style="{StaticResource Card}" Padding="26,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Greeting}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/><TextBlock Text="{Binding OverviewTitle}" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,9" TextWrapping="Wrap"/><TextBlock Text="{Binding OverviewDetail}" Style="{StaticResource Muted}" MaxWidth="650" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Margin="0,23,0,0"><Button Content="Scan My Network  →" Style="{StaticResource Primary}" Command="{Binding StartScanCommand}" Margin="0,0,10,0"/><Button Content="Find Cameras" Command="{Binding FindCamerasCommand}" Margin="0,0,10,0"/><Button Content="Network Map" Command="{Binding MapCommand}"/></StackPanel></StackPanel><Grid Grid.Column="1" Margin="25,0,0,0"><Ellipse Width="128" Height="128" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/><Ellipse Width="90" Height="90" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/><Ellipse Width="44" Height="44" Fill="{DynamicResource InputBrush}"/><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="12" Height="12" Fill="{DynamicResource GreenBrush}" Margin="0,0,0,127"/><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="105,70,0,0"/><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,50,81,0"/></Grid></Grid></Border>
       <ItemsControl ItemsSource="{Binding Stats}" Margin="0,17,-12,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0"><StackPanel><DockPanel><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><DockPanel><TextBlock Text="RECENT OBSERVATIONS" FontSize="10" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"/><TextBlock Text="Network activity" FontSize="16" FontWeight="SemiBold"/></DockPanel><ItemsControl ItemsSource="{Binding Events}" MaxHeight="208" Margin="0,17,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Category}" FontSize="12"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,12,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding At, StringFormat=HH:mm}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Activity appears here as devices are discovered or change." Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reachability overview" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding OnlineSummary}" Margin="0,25,0,12" Foreground="{DynamicResource GreenBrush}"/><ProgressBar Value="{Binding OnlinePercent, Mode=OneWay}" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="Based on last observations, not a network health score." Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,20"/><Border Height="1" Background="{DynamicResource BorderBrush}"/><TextBlock Text="Your CCTV infrastructure" Margin="0,18,0,7" FontWeight="SemiBold"/><TextBlock Text="{Binding CameraSummary}" Style="{StaticResource Muted}"/></StackPanel></Border>
       </Grid>
       <DockPanel Margin="0,22,0,10"><Button DockPanel.Dock="Right" Content="Export inventory" Command="{Binding ExportCommand}" Padding="12,6"/><TextBlock Text="Discovered devices" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedAsset}" Height="226"><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="IP ADDRESS" Binding="{Binding Ip}" Width="120"/><DataGridTextColumn Header="DEVICE" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="SERVICES" Binding="{Binding Ports}" Width="160"/></DataGrid.Columns></DataGrid>
      </StackPanel>
     </ScrollViewer>
     <!-- Scanner and inventory -->
     <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Network Scan|CCTV Discovery|Advanced Scan|Devices|Cameras|NVRs|Network Devices|Favorites}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Network Scan|CCTV Discovery|Advanced Scan}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NETWORK ADAPTER" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Label" AutomationProperties.Name="Network adapter"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SCAN TARGET · IPv4 OR CIDR" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,9"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scan target"/></StackPanel><StackPanel Grid.Column="4" VerticalAlignment="Bottom"><Button Content="Start scan  →" Command="{Binding StartScanCommand}" Style="{StaticResource Primary}" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Network Scan|Advanced Scan}"/><Button Content="Find Cameras  →" Command="{Binding FindCamerasCommand}" Style="{StaticResource Primary}" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=CCTV Discovery}"/></StackPanel></Grid><TextBlock Text="Use only on networks you own or are authorized to administer." Style="{StaticResource Muted}" FontSize="11" Margin="0,15,0,0"/><StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=CCTV Discovery}" Margin="0,18,0,0"><TextBlock Text="Installer workspace" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="ONVIF multicast searches the selected local interface. TCP discovery covers the entered target using Windows routing. Isolated networks cannot be discovered; RTSP alone does not confirm a camera." Style="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock Text="Authenticated camera configuration and stream playback are not available in this build." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Advanced Scan}" Margin="0,22,0,0"><TextBlock Text="Discovery performance" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="TCP ports (comma separated)" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="{Binding PortText}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Concurrent hosts" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="{Binding Concurrency}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Timeout (ms)" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="{Binding TimeoutMs}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Maximum hosts" Style="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="{Binding MaximumHosts}"/></StackPanel></Grid><TextBlock Text="ICMP → limited TCP discovery → selected ports → service identification. Higher concurrency increases network load." Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/></StackPanel>
      </StackPanel></Border>
      <DockPanel Grid.Row="1" Margin="0,0,0,13"><Button DockPanel.Dock="Right" Content="Export results" Command="{Binding ExportCommand}" Padding="12,6"/><TextBlock Text="{Binding DeviceCountLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedAsset}"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="Copy IP" Command="{Binding CopyIpCommand}"/><MenuItem Header="Open Web UI" Command="{Binding WebCommand}"/><MenuItem Header="Toggle favorite" Command="{Binding FavoriteCommand}"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="78"/><DataGridTextColumn Header="IP ADDRESS" Binding="{Binding Ip}" Width="120"/><DataGridTextColumn Header="DEVICE" Binding="{Binding DisplayName}" Width="*" MinWidth="150"/><DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="VENDOR" Binding="{Binding Vendor}" Width="135"/><DataGridTextColumn Header="PORTS" Binding="{Binding Ports}" Width="160"/><DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="100"/></DataGrid.Columns></DataGrid>
     </Grid>
     <!-- Evidence map -->
     <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Network Map}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Click="ZoomOut" Margin="5,0" ToolTip="Zoom out"/><Button Content="+" Click="ZoomIn" Margin="5,0" ToolTip="Zoom in"/><Button Content="Reset layout" Click="ResetMap" Margin="5,0"/><Button Content="Export PNG" Click="ExportMap"/></StackPanel><StackPanel><TextBlock Text="Observed topology" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding MapCaption}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></DockPanel><local:NetworkMapControl x:Name="NetworkMap" Grid.Row="1" Assets="{Binding Assets}" Edges="{Binding Edges}"/></Grid>
     <!-- Structured evidence views -->
     <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Services|IPAM|Subnets|VLANs|Routing|DNS / DHCP|Live Monitoring|Alerts|Events|Changes|Security Assessment|Dependencies|Scan History}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="{Binding MonitoringLabel}" Command="{Binding MonitoringCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Live Monitoring}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"><DataGrid.Columns><DataGridTextColumn Header="SOURCE" Binding="{Binding Primary}" Width="160"/><DataGridTextColumn Header="OBSERVATION" Binding="{Binding Secondary}" Width="260"/><DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="150"/></DataGrid.Columns></DataGrid></Grid>
     <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Reports}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="A clear record of your network" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Export the current inventory as CSV, JSON, text, or a printable HTML report. Demo exports are labeled synthetic." Style="{StaticResource Muted}" Margin="0,12,0,22"/><Button Content="Export inventory" Command="{Binding ExportCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
     <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance &amp; scan defaults" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Light theme" IsChecked="{Binding LightTheme}" Margin="0,22,0,15"/><TextBlock Text="Set concurrency, timeout, and host limits in Advanced Scan. Save here to retain them for your next session." Style="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,23,0,0"><Button Content="Save preferences" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button Content="Refresh adapters" Command="{Binding RefreshAdaptersCommand}"/></StackPanel><TextBlock Text="Live inventory, settings, and rotating logs are stored under your Windows account in LocalAppData\Empiro." Style="{StaticResource Muted}" FontSize="11" Margin="0,22,0,0"/></StackPanel></Border></StackPanel>
     <!-- Device inspector -->
     <Border Width="375" HorizontalAlignment="Right" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
      <DockPanel><Button DockPanel.Dock="Top" Content="Close details  ×" Command="{Binding CloseInspectorCommand}" HorizontalAlignment="Right" Padding="8,5" Margin="0,0,0,15"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="DEVICE INSPECTOR" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding SelectedAsset.DisplayName}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,13,0,8"/><TextBlock Text="{Binding SelectedAsset.Ip}" FontSize="17"/><TextBlock Text="{Binding SelectedAsset.Status}" Foreground="{DynamicResource GreenBrush}" Margin="0,8,0,18"/><TextBlock Text="{Binding SelectedAsset.Model}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedAsset.Mac}" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedAsset.Confidence, StringFormat=Identification confidence: {0}%}" Style="{StaticResource Muted}" Margin="0,10,0,18"/><WrapPanel><Button Content="Copy IP" Command="{Binding CopyIpCommand}" Padding="10,7" Margin="0,0,7,7"/><Button Content="Web UI" Command="{Binding WebCommand}" Padding="10,7" Margin="0,0,7,7"/><Button Content="Favorite ☆" Command="{Binding FavoriteCommand}" Padding="10,7" Margin="0,0,0,7"/></WrapPanel><TextBlock Text="Services" FontWeight="SemiBold" Margin="0,18,0,8"/><ItemsControl ItemsSource="{Binding SelectedAsset.Services}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,9"><TextBlock><Run Text="{Binding Port}"/><Run Text=" / "/><Run Text="{Binding Name}"/></TextBlock><TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Evidence &amp; provenance" FontWeight="SemiBold" Margin="0,15,0,10"/><TextBlock Text="{Binding SelectedEvidence}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="Tags" Style="{StaticResource Muted}" Margin="0,14,0,7"/><TextBox Text="{Binding Tags}"/><Button Content="Save details" Command="{Binding SaveNotesCommand}" Margin="0,12,0,0"/></StackPanel></ScrollViewer></DockPanel>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,9"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></Border>
  </Grid>
 </Grid>
</Window>
